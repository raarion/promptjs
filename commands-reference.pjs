---
judul: "PromptJS Command Reference"
versi: "v1.1.1"
placeholderCari: "Cari command... (misal: build, test, lint, audit)"
---

Halaman Utama:
    data cari = ""
    data toastTeks = ""

    Gaya:
        *
        *::before
        *::after
            box-sizing: border-box
            margin: 0
            padding: 0

        body
            font-family: 'Inter', 'SF Pro', system-ui, sans-serif
            background: #0a0a1a
            color: #e0e0f0
            min-height: 100vh

        body::before
            content: ""
            position: fixed
            inset: 0
            background: radial-gradient(ellipse 80% 60% at 20% 10%, rgba(120,60,200,0.08), transparent), radial-gradient(ellipse 60% 80% at 80% 90%, rgba(0,180,180,0.06), transparent)
            pointer-events: none
            z-index: 0

        .container
            position: relative
            z-index: 1
            max-width: 900px
            margin: 0 auto
            padding: 24px 20px 60px

        header
            text-align: center
            padding: 40px 0 24px

        header .logo
            font-size: 3rem
            display: block
            margin-bottom: 8px
            filter: drop-shadow(0 0 20px rgba(255,0,110,0.3))

        header h1
            font-size: 2rem
            font-weight: 800
            background: linear-gradient(135deg, #ff006e, #ff99c8, #7dd3fc)
            -webkit-background-clip: text
            -webkit-text-fill-color: transparent
            background-clip: text

        header p
            color: #8888aa
            margin-top: 6px
            font-size: 0.95rem

        .badge-row
            display: flex
            gap: 8px
            justify-content: center
            flex-wrap: wrap
            margin-top: 14px

        .badge
            font-size: 0.72rem
            font-weight: 700
            padding: 4px 12px
            border-radius: 20px
            border: 1px solid rgba(255,255,255,0.1)
            background: rgba(255,255,255,0.04)
            color: #9999bb
            letter-spacing: 0.02em

        .badge.hl
            color: #7dd3fc
            border-color: rgba(125,211,252,0.25)

        .search-wrap
            position: sticky
            top: 12px
            z-index: 10
            margin: 0 0 28px

        .search-box
            width: 100%
            padding: 12px 16px 12px 42px
            border-radius: 12px
            border: 1px solid rgba(255,255,255,0.1)
            background: rgba(15,15,35,0.85)
            backdrop-filter: blur(12px)
            color: #e0e0f0
            font-size: 0.95rem
            outline: none
            transition: border-color 0.2s

        .search-box:focus
            border-color: #ff006e

        .search-icon
            position: absolute
            left: 14px
            top: 50%
            transform: translateY(-50%)
            color: #666
            pointer-events: none
            font-size: 0.95rem

        .category
            margin-bottom: 28px

        .cat-header
            display: flex
            align-items: center
            gap: 10px
            margin-bottom: 14px
            padding-bottom: 8px
            border-bottom: 1px solid rgba(255,255,255,0.06)

        .cat-emoji
            font-size: 1.4rem

        .cat-title
            font-size: 1.05rem
            font-weight: 700
            color: #c0c0d8

        .cat-count
            font-size: 0.65rem
            font-weight: 700
            padding: 2px 8px
            border-radius: 10px
            background: rgba(255,255,255,0.05)
            color: #6666aa

        .cmd-row
            display: flex
            align-items: center
            gap: 10px
            padding: 8px 12px
            border-radius: 8px
            transition: background 0.15s
            margin-bottom: 2px

        .cmd-row:hover
            background: rgba(255,255,255,0.03)

        .cmd-row.hidden
            display: none

        .cmd-code
            flex: 1
            font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace
            font-size: 0.82rem
            color: #7dd3fc
            min-width: 0
            overflow-wrap: anywhere
            line-height: 1.5

        .cmd-desc
            font-size: 0.78rem
            color: #7777a0
            flex-shrink: 0
            max-width: 340px
            min-width: 140px
            line-height: 1.4

        .copy-btn
            flex-shrink: 0
            width: 32px
            height: 32px
            border-radius: 8px
            border: 1px solid rgba(255,255,255,0.08)
            background: rgba(255,255,255,0.03)
            color: #555
            cursor: pointer
            display: flex
            align-items: center
            justify-content: center
            transition: all 0.15s
            font-size: 0.85rem

        .copy-btn:hover
            color: #7dd3fc
            border-color: rgba(125,211,252,0.3)
            background: rgba(125,211,252,0.06)

        .copy-btn.copied
            color: #86efac
            border-color: rgba(134,239,172,0.4)
            background: rgba(134,239,172,0.08)

        .no-result
            text-align: center
            padding: 60px 20px
            color: #5555aa

        .no-result .big
            font-size: 3rem
            display: block
            margin-bottom: 12px

        .toast
            position: fixed
            bottom: 24px
            left: 50%
            transform: translateX(-50%) translateY(100px)
            background: #1a1a30
            border: 1px solid rgba(134,239,172,0.3)
            color: #86efac
            padding: 10px 20px
            border-radius: 10px
            font-size: 0.85rem
            font-weight: 600
            z-index: 100
            pointer-events: none
            transition: transform 0.25s cubic-bezier(0.4,0,0.2,1)
            box-shadow: 0 8px 32px rgba(0,0,0,0.4)

        .toast.show
            transform: translateX(-50%) translateY(0)

        footer
            text-align: center
            padding: 20px
            color: #444466
            font-size: 0.75rem
            border-top: 1px solid rgba(255,255,255,0.04)
            margin-top: 32px

        footer a
            color: #7dd3fc
            text-decoration: none

        @media (max-width: 680px)
            header h1
                font-size: 1.5rem

            .cmd-row
                flex-wrap: wrap
                gap: 6px

            .cmd-code
                flex-basis: 100%

            .cmd-desc
                flex-basis: calc(100% - 46px)
                max-width: none

            .copy-btn
                order: 3

    Buat div.container:
        Buat header:
            Buat span.logo: "🌀"
            Buat h1: $judul
            Buat p: "Klik ikon 📋 — copy command langsung ke clipboard"
            Buat div.badge-row:
                Buat span.badge.hl: $versi
                Buat span.badge: "60+ commands"
                Buat span.badge: "10 kategori"
                Buat span.badge: "🇮🇩 Standalone"

        Buat div.search-wrap:
            Buat span.search-icon: "🔍"
            Buat masukan#search-input.search-box:
                placeholder = $placeholderCari
                on_diketik = simpan document.querySelector("#search-input").value ke cari

        Buat div#cmd-container:
            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "📦"
                    Buat span.cat-title: "NPM Scripts"
                    Buat span.cat-count: "package.json"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm test"
                    Buat span.cmd-desc: "Jalankan seluruh suite testing (Vitest)"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm test")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run test:watch"
                    Buat span.cmd-desc: "Test dalam mode watch"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run test:watch")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run coverage"
                    Buat span.cmd-desc: "Test + laporan code coverage"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run coverage")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run mutation"
                    Buat span.cmd-desc: "Stryker mutation testing"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run mutation")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run lint"
                    Buat span.cmd-desc: "Periksa kode dengan ESLint"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run lint")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run lint:fix"
                    Buat span.cmd-desc: "Periksa & auto-fix ESLint"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run lint:fix")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run typecheck"
                    Buat span.cmd-desc: "Type check JSDoc (TypeScript)"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run typecheck")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run format"
                    Buat span.cmd-desc: "Format kode dengan Prettier"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run format")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run format:check"
                    Buat span.cmd-desc: "Cek format tanpa mengubah"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run format:check")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run build"
                    Buat span.cmd-desc: "Build produksi lengkap"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run build")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run standalone"
                    Buat span.cmd-desc: "Build bundle browser standalone"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run standalone")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run pages:build"
                    Buat span.cmd-desc: "Build situs showcase"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run pages:build")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run pages:deploy"
                    Buat span.cmd-desc: "Deploy ke GitHub Pages"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run pages:deploy")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run audit"
                    Buat span.cmd-desc: "Cek kerentanan keamanan"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run audit")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run audit:fix"
                    Buat span.cmd-desc: "Auto-fix kerentanan keamanan"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run audit:fix")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "💻"
                    Buat span.cat-title: "CLI Commands"
                    Buat span.cat-count: "pjs"
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs compile <input> [output]"
                    Buat span.cmd-desc: "Kompilasi file .pjs → .html"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs compile <input> [output]")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs build <source> <dest>"
                    Buat span.cmd-desc: "Build seluruh project"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs build <source> <dest>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs init [project-name]"
                    Buat span.cmd-desc: "Inisialisasi project baru"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs init [project-name]")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs serve [port]"
                    Buat span.cmd-desc: "Dev server + live reload"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs serve [port]")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs watch <input> <output>"
                    Buat span.cmd-desc: "Watch mode auto-compile"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs watch <input> <output>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs validate <file>"
                    Buat span.cmd-desc: "Validasi sintaks tanpa kompilasi"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs validate <file>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs version"
                    Buat span.cmd-desc: "Tampilkan versi PromptJS"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs version")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs help"
                    Buat span.cmd-desc: "Tampilkan bantuan CLI"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs help")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs -o, --output <dir>"
                    Buat span.cmd-desc: "Tentukan folder output"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs -o, --output <dir>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs -m, --minify"
                    Buat span.cmd-desc: "Minify output HTML/JS"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs -m, --minify")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs -s, --standalone"
                    Buat span.cmd-desc: "Gunakan runtime standalone"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs -s, --standalone")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs -w, --watch"
                    Buat span.cmd-desc: "Enable watch mode"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs -w, --watch")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs -v, --verbose"
                    Buat span.cmd-desc: "Output detail/log verbose"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs -v, --verbose")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs -c, --config <file>"
                    Buat span.cmd-desc: "Konfigurasi custom"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs -c, --config <file>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs --no-cache"
                    Buat span.cmd-desc: "Disable caching build"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs --no-cache")
                Buat div.cmd-row:
                    Buat code.cmd-code: "pjs --sourcemap"
                    Buat span.cmd-desc: "Generate source map"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("pjs --sourcemap")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "🔐"
                    Buat span.cat-title: "Git Hooks"
                    Buat span.cat-count: "Husky"
                Buat div.cmd-row:
                    Buat code.cmd-code: "git add . && git commit -m \"...\""
                    Buat span.cmd-desc: "Pre-commit (lint-staged) otomatis"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("git add . && git commit -m \"...\"")
                Buat div.cmd-row:
                    Buat code.cmd-code: "git push"
                    Buat span.cmd-desc: "Pre-push (full CI gate) otomatis"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("git push")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "🧪"
                    Buat span.cat-title: "Testing Commands"
                    Buat span.cat-count: "Vitest"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest run"
                    Buat span.cmd-desc: "Jalankan semua test"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest run")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest watch"
                    Buat span.cmd-desc: "Test dalam mode watch"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest watch")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest run --coverage"
                    Buat span.cmd-desc: "Test + coverage report"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest run --coverage")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest run tests/file.test.js"
                    Buat span.cmd-desc: "Jalankan test spesifik"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest run tests/file.test.js")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest run --reporter=verbose"
                    Buat span.cmd-desc: "Output test detail"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest run --reporter=verbose")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest run --bail=1"
                    Buat span.cmd-desc: "Stop setelah failure pertama"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest run --bail=1")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx vitest run --grep \"pattern\""
                    Buat span.cmd-desc: "Filter by name pattern"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx vitest run --grep \"pattern\"")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "📊"
                    Buat span.cat-title: "Code Quality Tools"
                    Buat span.cat-count: "ESLint · Prettier · tsc"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx eslint src/"
                    Buat span.cmd-desc: "Lint semua file src/"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx eslint src/")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx eslint src/**/*.js --fix"
                    Buat span.cmd-desc: "Auto-fix ESLint"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx eslint src/**/*.js --fix")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx eslint src/cli/index.js"
                    Buat span.cmd-desc: "Lint file spesifik"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx eslint src/cli/index.js")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx prettier --write src/"
                    Buat span.cmd-desc: "Format semua file src/"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx prettier --write src/")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx prettier --check src/"
                    Buat span.cmd-desc: "Cek format"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx prettier --check src/")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx prettier --write README.md"
                    Buat span.cmd-desc: "Format file spesifik"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx prettier --write README.md")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx tsc --noEmit"
                    Buat span.cmd-desc: "Type check tanpa generate"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx tsc --noEmit")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx tsc --noEmit --pretty"
                    Buat span.cmd-desc: "Type check output berwarna"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx tsc --noEmit --pretty")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "📦"
                    Buat span.cat-title: "Package Management"
                    Buat span.cat-count: "npm"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm install"
                    Buat span.cmd-desc: "Install semua dependencies"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm install")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm install --production"
                    Buat span.cmd-desc: "Hanya production deps"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm install --production")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm install <package>"
                    Buat span.cmd-desc: "Install package baru"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm install <package>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm install <package> --save-dev"
                    Buat span.cmd-desc: "Install dev dependency"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm install <package> --save-dev")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm uninstall <package>"
                    Buat span.cmd-desc: "Uninstall package"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm uninstall <package>")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm update"
                    Buat span.cmd-desc: "Update semua packages"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm update")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm outdated"
                    Buat span.cmd-desc: "Cek package yang ada update"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm outdated")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm ls"
                    Buat span.cmd-desc: "List installed packages (tree)"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm ls")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm audit"
                    Buat span.cmd-desc: "Cek kerentanan keamanan"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm audit")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm audit --json"
                    Buat span.cmd-desc: "Audit format JSON"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm audit --json")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm audit fix"
                    Buat span.cmd-desc: "Auto-fix (non-breaking)"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm audit fix")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm audit fix --force"
                    Buat span.cmd-desc: "Auto-fix + breaking changes"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm audit fix --force")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "🏷️"
                    Buat span.cat-title: "Release & Versioning"
                    Buat span.cat-count: "npm version"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm version patch"
                    Buat span.cmd-desc: "Bump patch: 1.1.1 → 1.1.2"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm version patch")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm version minor"
                    Buat span.cmd-desc: "Bump minor: 1.1.1 → 1.2.0"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm version minor")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm version major"
                    Buat span.cmd-desc: "Bump major: 1.1.1 → 2.0.0"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm version major")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm version 1.2.3"
                    Buat span.cmd-desc: "Set versi spesifik"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm version 1.2.3")
                Buat div.cmd-row:
                    Buat code.cmd-code: "git tag -a v1.1.1 -m \"Release v1.1.1\""
                    Buat span.cmd-desc: "Buat Git tag"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("git tag -a v1.1.1 -m \"Release v1.1.1\"")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm publish --access public"
                    Buat span.cmd-desc: "Publish ke npm registry"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm publish --access public")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm publish --dry-run"
                    Buat span.cmd-desc: "Simulasi publish"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm publish --dry-run")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "🌐"
                    Buat span.cat-title: "GitHub Pages & Deploy"
                    Buat span.cat-count: "Deploy"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run pages:build"
                    Buat span.cmd-desc: "Build situs showcase"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run pages:build")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run pages:deploy"
                    Buat span.cmd-desc: "Deploy ke GitHub Pages"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run pages:deploy")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npx gh-pages -d dist-pages"
                    Buat span.cmd-desc: "Manual deploy via gh-pages"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npx gh-pages -d dist-pages")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "🔍"
                    Buat span.cat-title: "Debugging & Inspection"
                    Buat span.cat-count: "Debug"
                Buat div.cmd-row:
                    Buat code.cmd-code: "node --inspect src/cli/index.js compile app.pjs"
                    Buat span.cmd-desc: "Debug CLI"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("node --inspect src/cli/index.js compile app.pjs")
                Buat div.cmd-row:
                    Buat code.cmd-code: "node --inspect-brk node_modules/.bin/vitest run tests/test.js"
                    Buat span.cmd-desc: "Debug test spesifik"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("node --inspect-brk node_modules/.bin/vitest run tests/test.js")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm pack --dry-run"
                    Buat span.cmd-desc: "Lihat isi package"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm pack --dry-run")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run analyze:bundle"
                    Buat span.cmd-desc: "Analisis ukuran bundle"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run analyze:bundle")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm ls --all"
                    Buat span.cmd-desc: "Cek dependency tree lengkap"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm ls --all")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm ls --engine-strict"
                    Buat span.cmd-desc: "Cek engine compatibility"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm ls --engine-strict")

            Buat bagian.category:
                Buat div.cat-header:
                    Buat span.cat-emoji: "🧹"
                    Buat span.cat-title: "Cleanup & Maintenance"
                    Buat span.cat-count: "Maintenance"
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run clean"
                    Buat span.cmd-desc: "Bersihkan folder build"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run clean")
                Buat div.cmd-row:
                    Buat code.cmd-code: "rm -rf node_modules && npm install"
                    Buat span.cmd-desc: "Hapus node_modules & reinstall"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("rm -rf node_modules && npm install")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm run prepare"
                    Buat span.cmd-desc: "Reset Git hooks"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm run prepare")
                Buat div.cmd-row:
                    Buat code.cmd-code: "npm cache clean --force"
                    Buat span.cmd-desc: "Clear npm cache"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("npm cache clean --force")
                Buat div.cmd-row:
                    Buat code.cmd-code: "rm package-lock.json && npm install"
                    Buat span.cmd-desc: "Hapus lock file & regenerate"
                    Buat tombol.copy-btn: "📋"
                        on_klik = navigator.clipboard.writeText("rm package-lock.json && npm install")

        Buat footer:
            Buat span:
                "Dibangun dengan 💚 di Indonesia · "
                Buat a:
                    "github.com/raarion/promptjs"
                    href = "https://github.com/raarion/promptjs"

        Buat div.toast#toast:
            toastTeks

    Saat cari:
        jalankan filterPerintah(cari)

    Saat toastTeks:
        Jika toastTeks tidak sama dengan "":
            jalankan tampilkanToast(toastTeks)
